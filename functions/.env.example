# Secret key of the Stripe account that creates the customer app's
# PaymentIntents. Used by verifyFoodOrderPaymentHttp. Copy to functions/.env.
STRIPE_SECRET_KEY=
# Signing secret (whsec_...) of the Stripe webhook endpoint for
# stripeFoodWebhook (event: payment_intent.succeeded).
STRIPE_WEBHOOK_SECRET=
# Server key for Google Routes API (computeRouteMatrix), used to price food
# delivery by road distance (deliveryFee.js). Restrict it to the Routes API.
# Without it, delivery is priced by straight-line distance.
GOOGLE_ROUTES_API_KEY=
