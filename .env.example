# Copy to .env.local and fill values. Never commit real secrets.

# Firebase web config (public client keys — still restrict in Google Cloud Console)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=gothai-ffea1.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=gothai-ffea1
VITE_FIREBASE_STORAGE_BUCKET=gothai-ffea1.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DATABASE_URL=

# Google Maps — restrict by HTTP referrer + APIs (Maps JavaScript, Geocoding)
VITE_GOOGLE_MAPS_API_KEY=
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Session security (client JWT session layer on top of Firebase Auth)
# Idle logout after N minutes without activity (default 30)
VITE_SESSION_IDLE_MINUTES=30
# Absolute max hours from JWT auth_time (default 12)
VITE_SESSION_MAX_HOURS=12
