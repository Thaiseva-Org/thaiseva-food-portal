    "@mui/styled-engine-sc": "^7.0.1",
    "@react-google-maps/api": "^2.19.3",
    "@react-pdf/renderer": "^4.3.0",
    "apexcharts": "^4.3.0",
    "axios": "^1.7.3",
    "chart.js": "^4.4.2",
    "clsx": "^2.1.1",
    "firebase": "^12.17.1",
    "motion": "^13.1.0",
    "papaparse": "^5.7.0",
    "react": "^19.2.8",
    "react-apexcharts": "^1.7.0",
